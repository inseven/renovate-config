{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(fix)",
    ":semanticCommitScopeDisabled",
    ":disableDependencyDashboard"
  ],
  "semanticCommits": "enabled",
  "commitMessageLowerCase": "never",
  "lockFileMaintenance": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true
  },
  "swift": {
    "managerFilePatterns": ["/(^|/)Package(_[A-Za-z]+)*\\.swift$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "commitMessagePrefix": "fix: 🦀"
    },
    {
      "groupName": "Rust dependencies",
      "group": {
        "commitMessageTopic": "{{{groupName}}} ({{#each upgrades}}{{{depName}}}{{#unless @last}}, {{/unless}}{{/each}})"
      },
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "ci: ⚙️",
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner"],
      "commitMessagePrefix": "ci: 🏃"
    },
    {
      "groupName": "GitHub Actions build steps",
      "group": {
        "commitMessageTopic": "{{{groupName}}} ({{#each upgrades}}{{{depName}}}{{#unless @last}}, {{/unless}}{{/each}})"
      },
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["mise"],
      "commitMessagePrefix": "build: 🔨",
      "commitMessageTopic": "{{{depName}}}"
    },
    {
      "groupName": "build tools",
      "group": {
        "commitMessageTopic": "{{{groupName}}} ({{#each upgrades}}{{{depName}}}{{#unless @last}}, {{/unless}}{{/each}})"
      },
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "automerge": false
    },
    {
      "matchManagers": ["bundler"],
      "commitMessagePrefix": "fix: 💎"
    },
    {
      "groupName": "Ruby gems",
      "group": {
        "commitMessageTopic": "{{{groupName}}} ({{#each upgrades}}{{{depName}}}{{#unless @last}}, {{/unless}}{{/each}})"
      },
      "matchManagers": ["bundler"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["bundler"],
      "matchFileNames": ["docs/Gemfile"],
      "commitMessagePrefix": "build(website): 💎"
    },
    {
      "groupName": "website gems",
      "matchManagers": ["bundler"],
      "matchFileNames": ["docs/Gemfile"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["swift"],
      "commitMessagePrefix": "fix: 🪽",
      "commitMessageTopic": "{{{depName}}}"
    },
    {
      "matchManagers": ["swift"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["git-submodules"],
      "commitMessagePrefix": "fix: 🧩"
    },
    {
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "groupName": null
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchDepNames": ["jdx/mise"],
      "groupName": null,
      "automerge": true
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "commitMessagePrefix": "fix: 🔒",
      "automerge": true
    }
  ]
}
